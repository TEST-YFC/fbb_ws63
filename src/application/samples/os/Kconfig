choice
    prompt "Select an OSAL IPC sample."
    depends on ENABLE_OS_SAMPLE

config SAMPLE_SUPPORT_OSAL_EVENT_FLAG
    bool
    prompt "Support OSAL event flag Sample."
    help
        This option enables the OSAL event flag AND-wait sample.

config SAMPLE_SUPPORT_OSAL_MUTEX
    bool
    prompt "Support OSAL mutex Sample."
    help
        This option enables the OSAL mutex exclusive-access sample.

config SAMPLE_SUPPORT_OSAL_MSG_QUEUE
    bool
    prompt "Support OSAL interrupt-to-task message queue Sample."
    help
        This option enables the interrupt-to-task message queue sample.

config SAMPLE_SUPPORT_OSAL_SEMAPHORE
    bool
    prompt "Support OSAL semaphore Sample."
    help
        This option enables the OSAL producer-consumer semaphore sample.

endchoice
