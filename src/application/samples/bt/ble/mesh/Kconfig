choice
    prompt "BLE mesh Sample"

config SAMPLE_SUPPORT_BLE_MESH_DEVICE
    bool "Support Ble Mesh device sample."

config SAMPLE_SUPPORT_BLE_MESH_PROV
    bool "Support Ble Mesh prov sample."
endchoice

config BLE_MESH_TARGET
    bool
    default y if SAMPLE_SUPPORT_BLE_MESH_PROV || SAMPLE_SUPPORT_BLE_MESH_DEVICE

config BLE_MESH_DEVICE
    bool
    default y if SAMPLE_SUPPORT_BLE_MESH_DEVICE

config BLE_MESH_PROVISIONER_ADV
    bool
    default y if SAMPLE_SUPPORT_BLE_MESH_PROV