choice
    prompt "Sample"

config SAMPLE_SUPPORT_BLE_SAMPLE
    bool "Support BLE Sample."

if SAMPLE_SUPPORT_BLE_SAMPLE
osource "application/samples/bt/ble/Kconfig"
endif

config SAMPLE_SUPPORT_SLE_SAMPLE
    bool "Support SLE Sample."

if SAMPLE_SUPPORT_SLE_SAMPLE
osource "application/samples/bt/sle/Kconfig"
endif

config SAMPLE_SUPPORT_CHBA_SAMPLE
    bool "Support CHBA Sample."

config SAMPLE_SUPPORT_MESH
    bool
    prompt "Support Mesh."
    default y
    help
        This option means support ble mesh sample.
if SAMPLE_SUPPORT_MESH
    config SAMPLE_SUPPORT_BLE_MESH
        bool
        prompt "Support Ble Mesh sample."
        default n
        help
            This option means support ble mesh sample.
    if SAMPLE_SUPPORT_BLE_MESH
    menu "Support Ble Mesh Sample Configuration"
        osource "application/samples/bt/ble/mesh/Kconfig"
    endmenu
    endif

    config SAMPLE_SUPPORT_SLE_MESH
        bool
        prompt "Support Sle Mesh sample."
        default y
        help
            This option means support sle mesh sample.
    if SAMPLE_SUPPORT_SLE_MESH
    menu "Support Sle Mesh Sample Configuration"
        osource "application/samples/bt/sle/mesh/Kconfig"
    endmenu
    endif

endif

endchoice