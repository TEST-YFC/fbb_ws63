choice
    prompt "SLE Sample"

config SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE
    bool "Support SLE Throughput Server Sample."

config LARGE_THROUGHPUT_SERVER
    bool "server large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE

config SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE
    bool "Support SLE Throughput Client Sample."

config LARGE_THROUGHPUT_CLIENT
    bool "client large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE

config SAMPLE_SUPPORT_SLE_HELLO_SERVER_SAMPLE
    bool "Support SLE Hello Server Sample."

config SAMPLE_SUPPORT_SLE_HELLO_CLIENT_SAMPLE
    bool "Support SLE Hello Client Sample."

config SAMPLE_SUPPORT_SLE_UART_SERVER_SAMPLE
    bool "Support SLE UART Server Sample."

config SAMPLE_SUPPORT_SLE_UART_CLIENT_SAMPLE
    bool "Support SLE UART Client Sample."

config SAMPLE_SUPPORT_SLE_SENSOR_REPORT_SERVER_SAMPLE
    bool "Support SLE Sensor Report Server Sample."

config SAMPLE_SUPPORT_SLE_SENSOR_REPORT_CLIENT_SAMPLE
    bool "Support SLE Sensor Report Client Sample."

endchoice

if SAMPLE_SUPPORT_SLE_UART_SERVER_SAMPLE || SAMPLE_SUPPORT_SLE_UART_CLIENT_SAMPLE
osource "application/samples/bt/sle/sle_uart/Kconfig"
endif

if SAMPLE_SUPPORT_SLE_SENSOR_REPORT_SERVER_SAMPLE || SAMPLE_SUPPORT_SLE_SENSOR_REPORT_CLIENT_SAMPLE
osource "application/samples/bt/sle/sle_sensor_report/Kconfig"
endif