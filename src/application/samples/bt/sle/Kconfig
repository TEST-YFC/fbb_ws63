    prompt "SLE Sample"

config SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE
    bool "Support SLE Throughput Server Sample."

config LARGE_THROUGHPUT_SERVER
    bool "server large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_SERVER_SAMPLE

config SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE
    bool "Support SLE Throughput Client Sample."

config LARGE_THROUGHPUT_CLIENT
    bool "client large throughput."
    default y
    depends on SAMPLE_SUPPORT_SLE_SPEED_CLIENT_SAMPLE

config SAMPLE_SUPPORT_SLE_DEVICE_CONFIG_SERVER_SAMPLE
    bool "Support SLE Device Config Server Sample."

if SAMPLE_SUPPORT_SLE_DEVICE_CONFIG_SERVER_SAMPLE
osource "application/samples/bt/sle/sle_device_config/Kconfig"
endif

config SAMPLE_SUPPORT_SLE_DEVICE_CONFIG_CLIENT_SAMPLE
    bool "Support SLE Device Config Client Sample."

if SAMPLE_SUPPORT_SLE_DEVICE_CONFIG_CLIENT_SAMPLE
osource "application/samples/bt/sle/sle_device_config/Kconfig"
endif

config SAMPLE_SUPPORT_SLE_FRAGMENTATION_SERVER_SAMPLE
    bool "Support SLE Fragmentation Server Sample."

if SAMPLE_SUPPORT_SLE_FRAGMENTATION_SERVER_SAMPLE
osource "application/samples/bt/sle/sle_fragmentation/Kconfig"
endif

config SAMPLE_SUPPORT_SLE_FRAGMENTATION_CLIENT_SAMPLE
    bool "Support SLE Fragmentation Client Sample."

if SAMPLE_SUPPORT_SLE_FRAGMENTATION_CLIENT_SAMPLE
osource "application/samples/bt/sle/sle_fragmentation/Kconfig"
endif

